# Canonical site origin, no trailing slash.
# Used for metadataBase, openGraph URLs, robots.txt and sitemap.xml.
# Defaults to the GitHub Pages mirror when unset.
NEXT_PUBLIC_SITE_URL=https://rajesh-1920.github.io/rajesh-1920-dev

# Only set for the GitHub Pages static export (see .github/workflows/deploy-pages.yml).
# Leave unset for Vercel, which serves the app from the domain root.
# NEXT_PUBLIC_BASE_PATH=/rajesh-1920-dev
